<%- include('partials/header') %>

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/products">Sản phẩm</a></li>
            <% if (categoryName !== 'Tất cả sản phẩm') { %>
                <li class="breadcrumb-item active" aria-current="page"><%= categoryName %></li>
            <% } %>
        </ol>
    </nav>

    <h1 class="mb-4"><%= categoryName %></h1>

    <% if (products.length === 0) { %>
        <div class="alert alert-warning">
            Không có sản phẩm nào trong danh mục này.
        </div>
    <% } else { %>
        <div class="row">
            <% products.forEach(product => { %>
                <div class="col-md-3 mb-4">
                    <div class="card h-100">
                        <div class="bg-light" style="height: 200px;">
                            <% if (product.image_url) { %>
                                <img src="<%= product.image_url %>" class="card-img-top h-100 object-fit-cover" alt="<%= product.name %>">
                            <% } else { %>
                                <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white">
                                    <i class="fas fa-coffee fa-3x"></i>
                                </div>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title"><%= product.name %></h5>
                            <p class="card-text small text-muted"><%= product.category_name %></p>
                            <p class="card-text text-truncate"><%= product.description %></p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-danger"><%= parseInt(product.price).toLocaleString('vi-VN') %> ₫</span>
                                <a href="/products/<%= product.id %>" class="btn btn-sm btn-outline-dark">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </div>
                            <button class="btn btn-dark w-100 mt-2 add-to-cart" data-id="<%= product.id %>">
                                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %> 