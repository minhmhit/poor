<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Quản lý đơn hàng</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <div class="btn-group me-2">
            <a href="/admin/invoices" class="btn btn-sm btn-outline-secondary">
              <i class="fas fa-file-invoice-dollar me-1"></i> Xem hóa đơn
            </a>
            <a href="/admin/reports/sales" class="btn btn-sm btn-outline-info">
              <i class="fas fa-chart-bar me-1"></i> Báo cáo doanh thu
            </a>
          </div>
        </div>
      </div>

      <!-- Bộ lọc đơn hàng -->
      <div class="card mb-3">
        <div class="card-body">
          <form method="GET" action="/admin/orders" class="row g-3">
            <div class="col-md-3">
              <label for="status" class="form-label">Trạng thái</label>
              <select class="form-select" id="status" name="status">
                <option value="">Tất cả trạng thái</option>
                <option value="pending" <%= filters && filters.status === 'pending' ? 'selected' : '' %>>Chờ xử lý</option>
                <option value="processing" <%= filters && filters.status === 'processing' ? 'selected' : '' %>>Đang xử lý</option>
                <option value="completed" <%= filters && filters.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
                <option value="cancelled" <%= filters && filters.status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
              </select>
            </div>
            <div class="col-md-4">
              <label for="search" class="form-label">Tìm kiếm</label>
              <input type="text" class="form-control" id="search" name="q" placeholder="ID, tên khách hàng, email..." value="<%= filters && filters.q ? filters.q : '' %>">
            </div>
            <div class="col-md-3">
              <label for="date" class="form-label">Ngày đặt hàng</label>
              <input type="date" class="form-control" id="date" name="date" value="<%= filters && filters.date ? filters.date : '' %>">
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary me-2">
                <i class="fas fa-search me-1"></i> Lọc
              </button>
              <a href="/admin/orders" class="btn btn-secondary">
                <i class="fas fa-sync-alt"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <% if (orders && orders.length > 0) { %>
        <div class="alert alert-info">
          Hiển thị <%= orders.length %> đơn hàng <%= filters && (filters.status || filters.q || filters.date) ? 'phù hợp với bộ lọc' : '' %>
        </div>
        
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Khách hàng</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Ngày đặt</th>
                <th>Ngày cập nhật</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(order => { %>
                <tr>
                  <td>#<%= order.id %></td>
                  <td>
                    <% if (order.user_id) { %>
                      <%= order.user_name || order.customer_name %><br>
                      <small class="text-muted"><%= order.user_email || order.customer_email %></small>
                    <% } else { %>
                      <%= order.customer_name || 'Khách vãng lai' %><br>
                      <small class="text-muted"><%= order.customer_email || '' %></small>
                    <% } %>
                  </td>
                  <td><%= parseInt(order.total_amount).toLocaleString('vi-VN') %> ₫</td>
                  <td>
                    <% if (order.status === 'pending') { %>
                      <span class="badge bg-warning">Chờ xử lý</span>
                    <% } else if (order.status === 'processing') { %>
                      <span class="badge bg-primary">Đang xử lý</span>
                    <% } else if (order.status === 'completed') { %>
                      <span class="badge bg-success">Hoàn thành</span>
                    <% } else if (order.status === 'cancelled') { %>
                      <span class="badge bg-danger">Đã hủy</span>
                    <% } %>
                  </td>
                  <td><%= new Date(order.created_at).toLocaleDateString('vi-VN') %></td>
                  <td><%= new Date(order.updated_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-info" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                      </a>
                      <% if (order.status === 'completed') { %>
                        <a href="/admin/orders/<%= order.id %>/print" class="btn btn-sm btn-secondary" title="In hóa đơn" target="_blank">
                          <i class="fas fa-print"></i>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-warning">
          <% if (filters && (filters.status || filters.q || filters.date)) { %>
            Không tìm thấy đơn hàng nào phù hợp với bộ lọc. <a href="/admin/orders">Xem tất cả đơn hàng</a>
          <% } else { %>
            Không có đơn hàng nào trong hệ thống.
          <% } %>
        </div>
      <% } %>
    </main>
  </div>
</div>
