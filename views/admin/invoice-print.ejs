<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/all.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }
    .invoice-box {
      max-width: 800px;
      margin: auto;
      padding: 30px;
      border: 1px solid #eee;
      box-shadow: 0 0 10px rgba(0, 0, 0, .15);
      font-size: 14px;
      line-height: 24px;
    }
    .invoice-box table {
      width: 100%;
      line-height: inherit;
      text-align: left;
    }
    .invoice-box table td {
      padding: 5px;
      vertical-align: top;
    }
    .invoice-box table tr.top table td {
      padding-bottom: 20px;
    }
    .invoice-box table tr.top table td.title {
      font-size: 40px;
      color: #333;
    }
    .invoice-box table tr.heading td {
      background: #eee;
      border-bottom: 1px solid #ddd;
      font-weight: bold;
    }
    .invoice-box table tr.details td {
      padding-bottom: 20px;
    }
    .invoice-box table tr.item td {
      border-bottom: 1px solid #eee;
    }
    .invoice-box table tr.item.last td {
      border-bottom: none;
    }
    .invoice-box table tr.total td {
      border-top: 2px solid #eee;
      font-weight: bold;
    }
    .text-right {
      text-align: right;
    }
    .print-button {
      max-width: 800px;
      margin: 20px auto;
      text-align: right;
    }
    @media print {
      .print-button, .no-print {
        display: none;
      }
      body {
        padding: 0;
      }
      .invoice-box {
        border: none;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>
  <div class="print-button">
    <button type="button" class="btn btn-primary" onclick="window.print()">
      <i class="fas fa-print"></i> In hóa đơn
    </button>
    <a href="/admin/orders/<%= order.id %>" class="btn btn-secondary ms-2">
      <i class="fas fa-arrow-left"></i> Quay lại
    </a>
  </div>
  
  <div class="invoice-box">
    <table cellpadding="0" cellspacing="0">
      <tr class="top">
        <td colspan="4">
          <table>
            <tr>
              <td class="title">
                <h4>MY SHOP</h4>
              </td>
              <td class="text-right">
                <h4>HÓA ĐƠN BÁN HÀNG</h4>
                Mã HD: <strong>#<%= order.id %></strong><br>
                Ngày: <%= new Date(order.created_at).toLocaleDateString('vi-VN') %><br>
                Trạng thái: <span class="badge bg-<%= order.status === 'completed' ? 'success' : 'warning' %>">
                  <%= order.status === 'completed' ? 'Hoàn thành' : (order.status === 'pending' ? 'Chờ xử lý' : order.status) %>
                </span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <tr class="information">
        <td colspan="4">
          <table>
            <tr>
              <td>
                <strong>Thông tin cửa hàng:</strong><br>
                MY SHOP<br>
                123 Đường ABC, Quận XYZ<br>
                TP.HCM, Việt Nam<br>
                Email: info@myshop.com<br>
                SĐT: 0123456789
              </td>
              <td class="text-right">
                <strong>Thông tin khách hàng:</strong><br>
                <%= order.customer_name || 'Khách hàng lẻ' %><br>
                <%= order.customer_address || 'N/A' %><br>
                SĐT: <%= order.customer_phone || 'N/A' %><br>
                Email: <%= order.customer_email || 'N/A' %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <tr class="heading">
        <td style="width: 50%;">Sản phẩm</td>
        <td style="width: 15%;" class="text-right">Đơn giá</td>
        <td style="width: 15%;" class="text-right">Số lượng</td>
        <td style="width: 20%;" class="text-right">Thành tiền</td>
      </tr>
      
      <% 
      let subtotal = 0;
      if (order.items && order.items.length > 0) {
        order.items.forEach((item, index) => {
          subtotal += item.price * item.quantity;
      %>
        <tr class="item <%= index === order.items.length - 1 ? 'last' : '' %>">
          <td><%= item.product_name %></td>
          <td class="text-right"><%= item.price.toLocaleString('vi-VN') %> đ</td>
          <td class="text-right"><%= item.quantity %></td>
          <td class="text-right"><%= (item.price * item.quantity).toLocaleString('vi-VN') %> đ</td>
        </tr>
      <% }); } %>
      
      <tr class="total">
        <td colspan="3" class="text-right">Tổng tiền hàng:</td>
        <td class="text-right"><%= subtotal.toLocaleString('vi-VN') %> đ</td>
      </tr>
      
      <% if (order.shipping_fee) { %>
      <tr>
        <td colspan="3" class="text-right">Phí vận chuyển:</td>
        <td class="text-right"><%= order.shipping_fee.toLocaleString('vi-VN') %> đ</td>
      </tr>
      <% } %>
      
      <% if (order.discount_amount) { %>
      <tr>
        <td colspan="3" class="text-right">Giảm giá:</td>
        <td class="text-right">-<%= order.discount_amount.toLocaleString('vi-VN') %> đ</td>
      </tr>
      <% } %>
      
      <tr class="total">
        <td colspan="3" class="text-right"><strong>Tổng thanh toán:</strong></td>
        <td class="text-right"><strong><%= order.total_amount.toLocaleString('vi-VN') %> đ</strong></td>
      </tr>
      
      <tr>
        <td colspan="4" style="padding-top: 30px;">
          <p><strong>Phương thức thanh toán:</strong> <%= order.payment_method || 'Thanh toán khi nhận hàng' %></p>
          <% if (order.note) { %>
          <p><strong>Ghi chú:</strong> <%= order.note %></p>
          <% } %>
        </td>
      </tr>
      
      <tr>
        <td colspan="4" style="padding-top: 20px;">
          <table style="width: 100%;">
            <tr>
              <td style="width: 50%;" class="text-center">
                <p style="margin-bottom: 80px;">Người mua hàng</p>
                <p><em>(Ký, ghi rõ họ tên)</em></p>
              </td>
              <td style="width: 50%;" class="text-center">
                <p style="margin-bottom: 80px;">Người bán hàng</p>
                <p><em>(Ký, ghi rõ họ tên)</em></p>
                <p><%= currentUser.name %></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    
    <div style="text-align: center; margin-top: 30px; font-style: italic; font-size: 12px;">
      <p>Cảm ơn Quý khách đã mua hàng tại MY SHOP!</p>
      <p>Hóa đơn điện tử này có giá trị như hóa đơn giấy.</p>
      <p>In ngày: <%= new Date().toLocaleString('vi-VN') %></p>
    </div>
  </div>
</body>
</html> 