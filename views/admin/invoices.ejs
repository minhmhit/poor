<%- include('../partials/admin-header') %>

<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin-sidebar') %>
    <div class="col-md-2"> <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link active" href="/admin">
          <i class="fas fa-tachometer-alt me-2"></i>
          Dashboard
        </a>
      </li>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/products">
          <i class="fas fa-box me-2"></i>
          Sản phẩm
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/categories">
          <i class="fas fa-tags me-2"></i>
          Danh mục
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/orders">
          <i class="fas fa-shopping-cart me-2"></i>
          Đơn hàng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc manager-->
      <% if (user.role === 'admin' || user.role === 'manager') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/users">
          <i class="fas fa-users me-2"></i>
          Người dùng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/suppliers">
          <i class="fas fa-truck me-2"></i>
          Nhà cung cấp
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/stock/imports">
          <i class="fas fa-warehouse me-2"></i>
          Nhập kho
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/invoices">
          <i class="fas fa-file-invoice-dollar me-2"></i>
          Hóa đơn bán hàng
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/admin/reports/sales">
          <i class="fas fa-chart-bar me-2"></i>
          Báo cáo doanh thu
        </a>
      </li>
      <% } %>
    </ul></div>
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><%= title %></h1>
      </div>
      
      <% if (messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= messages.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <% if (messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= messages.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <!-- Bộ lọc theo thời gian -->
      <div class="card mb-4">
        <div class="card-header">
          <i class="fas fa-filter me-1"></i>
          Lọc hóa đơn theo thời gian
        </div>
        <div class="card-body">
          <form method="GET" action="/admin/invoices" class="row g-3">
            <div class="col-md-4">
              <label for="start_date" class="form-label">Từ ngày</label>
              <input type="date" class="form-control" id="start_date" name="start_date" 
                     value="<%= filters.start_date ? filters.start_date.toISOString().split('T')[0] : '' %>">
            </div>
            <div class="col-md-4">
              <label for="end_date" class="form-label">Đến ngày</label>
              <input type="date" class="form-control" id="end_date" name="end_date"
                     value="<%= filters.end_date ? filters.end_date.toISOString().split('T')[0] : '' %>">
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <button type="submit" class="btn btn-primary me-2">
                <i class="fas fa-search me-1"></i> Lọc
              </button>
              <a href="/admin/invoices" class="btn btn-secondary">
                <i class="fas fa-sync-alt me-1"></i> Làm mới
              </a>
            </div>
          </form>
        </div>
      </div>
      
      <div class="card mb-4">
        <div class="card-header">
          <i class="fas fa-file-invoice me-1"></i>
          Danh sách hóa đơn
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-striped table-hover">
              <thead>
                <tr>
                  <th>Mã hóa đơn</th>
                  <th>Mã đơn hàng</th>
                  <th>Ngày tạo</th>
                  <th>Trạng thái đơn hàng</th>
                  <th>Tổng tiền</th>
                  <th>Người tạo</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <% if (invoices && invoices.length > 0) { %>
                  <% invoices.forEach(invoice => { %>
                    <tr>
                      <td>#<%= invoice.id %></td>
                      <td>#<%= invoice.order_id %></td>
                      <td><%= new Date(invoice.created_at).toLocaleString('vi-VN') %></td>
                      <td>
                        <% if (invoice.order_status === 'completed') { %>
                          <span class="badge bg-success">Hoàn thành</span>
                        <% } else if (invoice.order_status === 'cancelled') { %>
                          <span class="badge bg-danger">Đã hủy</span>
                        <% } else if (invoice.order_status === 'processing') { %>
                          <span class="badge bg-info">Đang xử lý</span>
                        <% } else if (invoice.order_status === 'shipped') { %>
                          <span class="badge bg-primary">Đang giao</span>
                        <% } else { %>
                          <span class="badge bg-secondary"><%= invoice.order_status || 'Không xác định' %></span>
                        <% } %>
                      </td>
                      <td><%= invoice.total_amount ? invoice.total_amount.toLocaleString('vi-VN') + ' đ' : 'N/A' %></td>
                      <td><%= invoice.created_by_name || 'Admin' %></td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <!-- <a href="/admin/invoices/<%= invoice.id %>" class="btn btn-outline-primary" title="Xem chi tiết">
                            <i class="fas fa-eye"></i>
                          </a> -->
                          <a href="/admin/orders/<%= invoice.order_id %>/print" class="btn btn-outline-success" title="In lại">
                            <i class="fas fa-print"></i>
                          </a>
                          <a href="/admin/orders/<%= invoice.order_id %>" class="btn btn-outline-info" title="Xem đơn hàng">
                            <i class="fas fa-shopping-cart"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center">Không có hóa đơn nào</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          
          <!-- Phân trang -->
          <% if (pagination.pages > 1) { %>
            <nav aria-label="Page navigation">
              <ul class="pagination justify-content-center mt-4">
                <li class="page-item <%= pagination.page === 1 ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/invoices?page=<%= pagination.page - 1 %>&start_date=<%= filters.start_date ? filters.start_date.toISOString().split('T')[0] : '' %>&end_date=<%= filters.end_date ? filters.end_date.toISOString().split('T')[0] : '' %>">Trước</a>
                </li>
                
                <% for (let i = 1; i <= pagination.pages; i++) { %>
                  <li class="page-item <%= pagination.page === i ? 'active' : '' %>">
                    <a class="page-link" href="/admin/invoices?page=<%= i %>&start_date=<%= filters.start_date ? filters.start_date.toISOString().split('T')[0] : '' %>&end_date=<%= filters.end_date ? filters.end_date.toISOString().split('T')[0] : '' %>"><%= i %></a>
                  </li>
                <% } %>
                
                <li class="page-item <%= pagination.page === pagination.pages ? 'disabled' : '' %>">
                  <a class="page-link" href="/admin/invoices?page=<%= pagination.page + 1 %>&start_date=<%= filters.start_date ? filters.start_date.toISOString().split('T')[0] : '' %>&end_date=<%= filters.end_date ? filters.end_date.toISOString().split('T')[0] : '' %>">Tiếp</a>
                </li>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/admin-footer') %> 