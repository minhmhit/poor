<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Chi tiết đơn hàng #<%= order.id %></h1>
        <a href="/admin/orders" class="btn btn-secondary">
          <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
      </div>

      <div class="row mb-4">
        <!-- Thông tin đơn hàng -->
        <div class="col-md-4">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Thông tin đơn hàng</h5>
            </div>
            <div class="card-body">
              <p><strong>Mã đơn hàng:</strong> #<%= order.id %></p>
              <p><strong>Ngày đặt:</strong> <%= new Date(order.created_at).toLocaleString('vi-VN') %></p>
              <p><strong>Tổng tiền:</strong> <%= order.total_amount.toLocaleString('vi-VN') %> ₫</p>
              <p>
                <strong>Trạng thái:</strong>
                <% if (order.status === 'pending') { %>
                  <span class="badge bg-warning">Chờ xử lý</span>
                <% } else if (order.status === 'processing') { %>
                  <span class="badge bg-primary">Đang xử lý</span>
                <% } else if (order.status === 'completed') { %>
                  <span class="badge bg-success">Hoàn thành</span>
                <% } else if (order.status === 'cancelled') { %>
                  <span class="badge bg-danger">Đã hủy</span>
                <% } %>
              </p>
            </div>
          </div>
        </div>

        <!-- Thông tin khách hàng -->
        <div class="col-md-4">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Thông tin khách hàng</h5>
            </div>
            <div class="card-body">
              <p><strong>Tên:</strong> <%= order.customer_name || order.user_name || 'Không có' %></p>
              <p><strong>Email:</strong> <%= order.customer_email || order.user_email || 'Không có' %></p>
              <p><strong>Số điện thoại:</strong> <%= order.contact_phone || 'Không có' %></p>
              <p><strong>Địa chỉ:</strong> <%= order.shipping_address || 'Không có' %></p>
              <% if (order.user_id) { %>
                <p><a href="/admin/users/<%= order.user_id %>" class="btn btn-sm btn-outline-primary">Xem thông tin tài khoản</a></p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Cập nhật trạng thái -->
        <div class="col-md-4">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Cập nhật trạng thái</h5>
            </div>
            <div class="card-body">
              <form action="/admin/orders/<%= order.id %>/update-status" method="POST">
                <div class="mb-3">
                  <label for="status" class="form-label">Trạng thái mới</label>
                  <select class="form-select" id="status" name="status" required>
                    <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Chờ xử lý</option>
                    <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Đang xử lý</option>
                    <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
                    <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Đã hủy</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label for="note" class="form-label">Ghi chú</label>
                  <textarea class="form-control" id="note" name="note" rows="2"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100">Cập nhật trạng thái</button>
              </form>
            </div>
          </div>
        </div>
      </div>

      <!-- Danh sách sản phẩm -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Sản phẩm trong đơn hàng</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>Sản phẩm</th>
                  <th>Đơn giá</th>
                  <th>Số lượng</th>
                  <th>Thành tiền</th>
                </tr>
              </thead>
              <tbody>
                <% order.items.forEach(item => { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center">
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" class="img-thumbnail me-2" style="width: 50px; height: 50px;">
                        <div>
                          <div><%= item.name %></div>
                          <small class="text-muted">ID: <%= item.product_id %></small>
                        </div>
                      </div>
                    </td>
                    <td><%= parseInt(item.price).toLocaleString('vi-VN') %> ₫</td>
                    <td><%= item.quantity %></td>
                    <td><%= (parseInt(item.price) * parseInt(item.quantity)).toLocaleString('vi-VN') %> ₫</td>
                  </tr>
                <% }); %>
                <tr class="table-secondary">
                  <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                  <td class="fw-bold"><%= parseInt(order.total_amount).toLocaleString('vi-VN') %> ₫</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Lịch sử trạng thái -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Lịch sử trạng thái</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>Thời gian</th>
                  <th>Trạng thái</th>
                  <th>Ghi chú</th>
                </tr>
              </thead>
              <tbody>
                <% if (statusHistory && statusHistory.length > 0) { %>
                  <% statusHistory.forEach(status => { %>
                    <tr>
                      <td><%= new Date(status.created_at).toLocaleString('vi-VN') %></td>
                      <td>
                        <% if (status.status === 'pending') { %>
                          <span class="badge bg-warning">Chờ xử lý</span>
                        <% } else if (status.status === 'processing') { %>
                          <span class="badge bg-primary">Đang xử lý</span>
                        <% } else if (status.status === 'completed') { %>
                          <span class="badge bg-success">Hoàn thành</span>
                        <% } else if (status.status === 'cancelled') { %>
                          <span class="badge bg-danger">Đã hủy</span>
                        <% } %>
                      </td>
                      <td><%= status.note || 'Không có ghi chú' %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="3" class="text-center">Không có lịch sử trạng thái</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
