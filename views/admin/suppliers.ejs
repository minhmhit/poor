<%- include('../partials/admin-header') %>

<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Quản lý nhà cung cấp</h1>
    <a href="/admin/suppliers/add" class="btn btn-primary">
      <i class="fas fa-plus"></i> Thêm nhà cung cấp mới
    </a>
  </div>

  <!-- Thông báo -->
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= messages.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (messages && messages.error && messages.error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= messages.error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Card bọc bảng nhà cung cấp -->
  <div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
      <h6 class="m-0 font-weight-bold text-primary">Danh sách nhà cung cấp</h6>
      
      <!-- Form tìm kiếm và lọc -->
      <form action="/admin/suppliers" method="GET" class="d-flex">
        <div class="input-group me-2" style="width: 250px;">
          <input type="text" name="q" class="form-control" placeholder="Tìm kiếm..." value="<%= filters.q %>">
          <button class="btn btn-outline-secondary" type="submit">
            <i class="fas fa-search"></i>
          </button>
        </div>
        
        <select name="status" class="form-select me-2" style="width: 150px;" onchange="this.form.submit()">
          <option value="" <%= !filters.status ? 'selected' : '' %>>Tất cả trạng thái</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Đang hoạt động</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Ngừng hoạt động</option>
        </select>
      </form>
    </div>
    
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
          <thead>
            <tr>
              <th>Mã</th>
              <th>Tên nhà cung cấp</th>
              <th>Địa chỉ</th>
              <th>Điện thoại</th>
              <th>Email</th>
              <th>Trạng thái</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% if (suppliers && suppliers.length > 0) { %>
              <% suppliers.forEach(supplier => { %>
                <tr>
                  <td><%= supplier.supplier_id %></td>
                  <td><%= supplier.name %></td>
                  <td><%= supplier.address %></td>
                  <td><%= supplier.phone %></td>
                  <td><%= supplier.email %></td>
                  <td>
                    <% if (supplier.status === 'active') { %>
                      <span class="badge bg-success">Đang hoạt động</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Ngừng hoạt động</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="btn-group" role="group">
                      <a href="/admin/suppliers/<%= supplier.supplier_id %>" class="btn btn-info btn-sm" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/suppliers/edit/<%= supplier.supplier_id %>" class="btn btn-warning btn-sm" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                      </a>
                      <a href="/admin/suppliers/delete/<%= supplier.supplier_id %>" class="btn btn-danger btn-sm" 
                         onclick="return confirm('Bạn có chắc chắn muốn xóa nhà cung cấp này?')" title="Xóa">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center">Không có nhà cung cấp nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin-footer') %> 