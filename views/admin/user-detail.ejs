<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Thông tin người dùng: <%= user.name %></h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <a href="/admin/users/<%= user.id %>/edit" class="btn btn-sm btn-primary me-2">
            <i class="fas fa-edit me-1"></i> Chỉnh sửa
          </a>
          <a href="/admin/users" class="btn btn-sm btn-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
          </a>
        </div>
      </div>

      <div class="row mb-4">
        <!-- Thông tin người dùng -->
        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Thông tin tài khoản</h5>
            </div>
            <div class="card-body">
              <p><strong>ID:</strong> #<%= user.id %></p>
              <p><strong>Họ tên:</strong> <%= user.name %></p>
              <p><strong>Email:</strong> <%= user.email %></p>
              <p>
                <strong>Quyền:</strong>
                <% if (user.role === 'admin') { %>
                  <span class="badge bg-danger">Quản trị viên</span>
                <% } else if (user.role === 'manager')  { %>
                  <span class="badge bg-warning">Quản lý</span>
                <% } else if (user.role === 'sale') { %>
                  <span class="badge bg-success">Nhân viên bán hàng</span>
                <% } else if (user.role === 'warehouse') { %>
                  <span class="badge bg-info">Nhân viên kho</span>
                <% } else { %>
                  <span class="badge bg-success">Khách hàng</span>
                <% } %>
              </p>
              <p>
                <strong>Trạng thái:</strong>
                <% if (user.status === 'active') { %>
                  <span class="badge bg-success">Hoạt động</span>
                <% } else { %>
                  <span class="badge bg-danger">Vô hiệu hóa</span>
                <% } %>
              </p>
              <p><strong>Ngày đăng ký:</strong> <%= new Date(user.created_at).toLocaleString('vi-VN') %></p>
            </div>
          </div>
          
          <!-- Cập nhật trạng thái -->
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Cập nhật trạng thái tài khoản</h5>
            </div>
            <div class="card-body">
              <form action="/admin/users/<%= user.id %>/update-status" method="POST">
                <div class="mb-3">
                  <label for="status" class="form-label">Trạng thái</label>
                  <select class="form-select" id="status" name="status" required>
                    <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Hoạt động</option>
                    <option value="inactive" <%= user.status === 'inactive' ? 'selected' : '' %>>Vô hiệu hóa</option>
                  </select>
                </div>
                <div class="d-grid">
                  <button type="submit" class="btn btn-primary">Cập nhật trạng thái</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Thông tin khách hàng -->
        <div class="col-md-6">
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="card-title mb-0">Thông tin liên hệ</h5>
            </div>
            <div class="card-body">
              <% if (user.customerInfo) { %>
                <p><strong>Số điện thoại:</strong> <%= user.customerInfo.phone || 'Chưa cung cấp' %></p>
                <p><strong>Địa chỉ:</strong> <%= user.customerInfo.address || 'Chưa cung cấp' %></p>
                <p><strong>Thành phố:</strong> <%= user.customerInfo.city || 'Chưa cung cấp' %></p>
                <p><strong>Quận/Huyện:</strong> <%= user.customerInfo.district || 'Chưa cung cấp' %></p>
                <p><strong>Mã bưu điện:</strong> <%= user.customerInfo.zipcode || 'Chưa cung cấp' %></p>
              <% } else { %>
                <p class="text-center text-muted">Người dùng chưa cập nhật thông tin liên hệ</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Danh sách đơn hàng -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">Lịch sử đơn hàng</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table mb-0">
              <thead>
                <tr>
                  <th>Mã đơn hàng</th>
                  <th>Ngày đặt</th>
                  <th>Tổng tiền</th>
                  <th>Trạng thái</th>
                  <th>Hành động</th>
                </tr>
              </thead>
              <tbody>
                <% if (user.orders && user.orders.length > 0) { %>
                  <% user.orders.forEach(order => { %>
                    <tr>
                      <td>#<%= order.id %></td>
                      <td><%= new Date(order.created_at).toLocaleDateString('vi-VN') %></td>
                      <td><%= order.total_amount.toLocaleString('vi-VN') %> ₫</td>
                      <td>
                        <% if (order.status === 'pending') { %>
                          <span class="badge bg-warning">Chờ xử lý</span>
                        <% } else if (order.status === 'processing') { %>
                          <span class="badge bg-primary">Đang xử lý</span>
                        <% } else if (order.status === 'completed') { %>
                          <span class="badge bg-success">Hoàn thành</span>
                        <% } else if (order.status === 'cancelled') { %>
                          <span class="badge bg-danger">Đã hủy</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-info">
                          <i class="fas fa-eye"></i>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center">Người dùng chưa có đơn hàng nào</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
