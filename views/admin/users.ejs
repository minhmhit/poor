<%- include('../partials/admin-header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Quản lý người dùng</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <div class="btn-group me-2">
            <a href="/admin/users/add" class="btn btn-sm btn-primary">
              <i class="fas fa-user-plus"></i> Thêm người dùng mới
            </a>
          </div>
        </div>
      </div>

      <% if (messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= messages.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <% if (messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= messages.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Bộ lọc người dùng -->
      <div class="card mb-3">
        <div class="card-body">
          <form method="GET" action="/admin/users" class="row g-3">
            <div class="col-md-3">
              <label for="role" class="form-label">Quyền</label>
              <select class="form-select" id="role" name="role">
                <option value="">Tất cả quyền</option>
                <option value="admin" <%= filters && filters.role === 'admin' ? 'selected' : '' %>>Quản trị viên</option>
                <option value="customer" <%= filters && filters.role === 'customer' ? 'selected' : '' %>>Khách hàng</option>
                <option value="warehouse" <%= filters && filters.role === 'warehouse' ? 'selected' : '' %>>Nhân viên kho</option>
                <option value="manager" <%= filters && filters.role === 'manager' ? 'selected' : '' %>>Quản lý</option>
                <option value="sale" <%= filters && filters.role === 'sale' ? 'selected' : '' %>>Nhân viên bán hàng</option>
              </select>
            </div>
            <div class="col-md-3">
              <label for="search" class="form-label">Tìm kiếm</label>
              <input type="text" class="form-control" id="search" name="q" placeholder="Tên người dùng, email..." value="<%= filters && filters.q ? filters.q : '' %>">
            </div>
            <div class="col-md-2">
              <label for="status" class="form-label">Trạng thái</label>
              <select class="form-select" id="status" name="status">
                <option value="">Tất cả trạng thái</option>
                <option value="active" <%= filters && filters.status === 'active' ? 'selected' : '' %>>Hoạt động</option>
                <option value="inactive" <%= filters && filters.status === 'inactive' ? 'selected' : '' %>>Vô hiệu hóa</option>
              </select>
            </div>
            <div class="col-md-2">
              <label for="date" class="form-label">Ngày đăng ký</label>
              <input type="date" class="form-control" id="date" name="date" value="<%= filters && filters.date ? filters.date : '' %>">
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary me-2">
                <i class="fas fa-search me-1"></i> Lọc
              </button>
              <a href="/admin/users" class="btn btn-secondary">
                <i class="fas fa-sync-alt"></i>
              </a>
            </div>
          </form>
        </div>
      </div>

      <% if (users && users.length > 0) { %>
        <div class="alert alert-info">
          Hiển thị <%= users.length %> người dùng <%= filters && (filters.role || filters.q || filters.date || filters.status) ? 'phù hợp với bộ lọc' : '' %>
        </div>
        
        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th>ID</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th>Trạng thái</th>
                <th>Đơn hàng</th>
                <th>Ngày đăng ký</th>
                <th>Hành động</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr>
                  <td>#<%= user.id %></td>
                  <td><%= user.name %></td>
                  <td><%= user.email %></td>
                  <td>
                    <span class="badge bg-<%= user.role === 'admin' ? 'danger' : (user.role === 'warehouse' ? 'warning' : (user.role === 'manager' ? 'info' : (user.role === 'sale' ? 'primary' : 'success'))) %>">
                      <%= user.role === 'admin' ? 'Quản trị viên' : (user.role === 'warehouse' ? 'Nhân viên kho' : (user.role === 'manager' ? 'Quản lý' : (user.role === 'sale' ? 'Nhân viên bán hàng' : 'Khách hàng'))) %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= user.status === 'active' || !user.status ? 'success' : 'secondary' %>">
                      <%= user.status === 'active' || !user.status ? 'Hoạt động' : 'Vô hiệu hóa' %>
                    </span>
                  </td>
                  <td><%= user.order_count || 0 %></td>
                  <td><%= new Date(user.created_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/users/<%= user.id %>" class="btn btn-outline-primary" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/users/<%= user.id %>/edit" class="btn btn-outline-secondary" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (user.role == 'user') { %>
                        <a href="#" class="btn btn-outline-danger" title="Xóa" 
                           onclick="confirmDelete('<%= user.id %>', '<%= user.name %>')">
                          <i class="fas fa-trash"></i>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="alert alert-warning">
          <% if (filters && (filters.role || filters.q || filters.date || filters.status)) { %>
            Không tìm thấy người dùng nào phù hợp với bộ lọc. <a href="/admin/users">Xem tất cả người dùng</a>
          <% } else { %>
            Không có người dùng nào trong hệ thống.
          <% } %>
        </div>
      <% } %>
    </main>
  </div>
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa người dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Bạn có chắc chắn muốn xóa người dùng <strong id="userName"></strong>?</p>
        <p class="text-danger">Hành động này không thể hoàn tác!</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
        <a href="#" id="confirmDeleteBtn" class="btn btn-danger">Xóa người dùng</a>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmDelete(userId, userName) {
    document.getElementById('userName').textContent = userName;
    document.getElementById('confirmDeleteBtn').href = `/admin/users/${userId}/delete`;
    var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
  }
</script>

<%- include('../partials/admin-footer') %>