<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Quản lý người dùng</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <div class="btn-group me-2">
            <a href="/admin/users/add" class="btn btn-sm btn-primary">
              <i class="fas fa-user-plus"></i> Thêm người dùng mới
            </a>
          </div>
        </div>
      </div>

      <% if (messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= messages.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      
      <% if (messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= messages.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Bộ lọc người dùng -->
      <div class="card mb-3">
        <div class="card-body">
          <form method="GET" action="/admin/users" class="row g-3">
            <div class="col-md-3">
              <label for="role" class="form-label">Quyền</label>
              <select class="form-select" id="role" name="role">
                <option value="">Tất cả quyền</option>
                <option value="admin">Quản trị viên</option>
                <option value="customer">Khách hàng</option>
                <option value="warehouse">Nhân viên kho</option>
                <option value="manager">Quản lý</option>
                <option value="sale">Nhân viên bán hàng</option>
              </select>
            </div>
            <div class="col-md-5">
              <label for="search" class="form-label">Tìm kiếm</label>
              <input type="text" class="form-control" id="search" name="q" placeholder="Tên người dùng, email...">
            </div>
            <div class="col-md-2">
              <label for="date" class="form-label">Ngày đăng ký</label>
              <input type="date" class="form-control" id="date" name="date">
            </div>
            <div class="col-md-2 d-flex align-items-end">
              <button type="submit" class="btn btn-primary w-100">
                <i class="fas fa-search me-1"></i> Lọc
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Họ tên</th>
              <th>Email</th>
              <th>Vai trò</th>
              <th>Trạng thái</th>
              <th>Đơn hàng</th>
              <th>Ngày đăng ký</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(user => { %>
                <tr>
                  <td>#<%= user.id %></td>
                  <td><%= user.name %></td>
                  <td><%= user.email %></td>
                  <td>
                    <span class="badge bg-<%= user.role === 'admin' ? 'danger' : (user.role === 'warehouse' ? 'warning' : (user.role === 'manager' ? 'info' : (user.role === 'sale' ? 'primary' : 'success'))) %>">
                      <%= user.role === 'admin' ? 'Quản trị viên' : (user.role === 'warehouse' ? 'Nhân viên kho' : (user.role === 'manager' ? 'Quản lý' : (user.role === 'sale' ? 'Nhân viên bán hàng' : 'Khách hàng'))) %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= user.status === 'active' || !user.status ? 'success' : 'secondary' %>">
                      <%= user.status === 'active' || !user.status ? 'Hoạt động' : 'Vô hiệu hóa' %>
                    </span>
                  </td>
                  <td><%= user.order_count || 0 %></td>
                  <td><%= new Date(user.created_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/users/<%= user.id %>" class="btn btn-outline-primary" title="Xem chi tiết">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/admin/users/<%= user.id %>/edit" class="btn btn-outline-secondary" title="Chỉnh sửa">
                        <i class="fas fa-edit"></i>
                      </a>
                      <% if (user.role !== 'admin') { %>
                        <a href="#" class="btn btn-outline-danger" title="Xóa" 
                           onclick="confirmDelete('<%= user.id %>', '<%= user.name %>')">
                          <i class="fas fa-trash"></i>
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center">Không có người dùng nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa người dùng</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Bạn có chắc chắn muốn xóa người dùng <strong id="userName"></strong>?</p>
        <p class="text-danger">Hành động này không thể hoàn tác!</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
        <a href="#" id="confirmDeleteBtn" class="btn btn-danger">Xóa người dùng</a>
      </div>
    </div>
  </div>
</div>

<script>
  function confirmDelete(userId, userName) {
    document.getElementById('userName').textContent = userName;
    document.getElementById('confirmDeleteBtn').href = `/admin/users/${userId}/delete`;
    var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
    modal.show();
  }
</script>

<%- include('../partials/footer') %>
