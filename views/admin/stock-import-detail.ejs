<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar') %>
    <div class="col-md-2"> <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link active" href="/admin">
          <i class="fas fa-tachometer-alt me-2"></i>
          Dashboard
        </a>
      </li>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/products">
          <i class="fas fa-box me-2"></i>
          Sản phẩm
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/categories">
          <i class="fas fa-tags me-2"></i>
          Danh mục
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/orders">
          <i class="fas fa-shopping-cart me-2"></i>
          Đơn hàng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc manager-->
      <% if (user.role === 'admin' || user.role === 'manager') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/users">
          <i class="fas fa-users me-2"></i>
          Người dùng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/suppliers">
          <i class="fas fa-truck me-2"></i>
          Nhà cung cấp
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/stock/imports">
          <i class="fas fa-warehouse me-2"></i>
          Nhập kho
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/invoices">
          <i class="fas fa-file-invoice-dollar me-2"></i>
          Hóa đơn bán hàng
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/admin/reports/sales">
          <i class="fas fa-chart-bar me-2"></i>
          Báo cáo doanh thu
        </a>
      </li>
      <% } %>
    </ul></div>
    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <!-- Header -->
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Chi tiết phiếu nhập kho</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <div class="btn-group me-2">
            <a href="/admin/stock/imports" class="btn btn-sm btn-outline-secondary">
              <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
            <!-- <a href="/admin/stock/imports/<%= stockImport.id %>/print" class="btn btn-sm btn-outline-primary" target="_blank">
              <i class="fas fa-print me-1"></i> In phiếu
            </a> -->
          </div>
          <div class="btn-group">
            <!-- <a href="/admin/stock/imports/<%= stockImport.id %>/edit" class="btn btn-sm btn-outline-success">
              <i class="fas fa-edit me-1"></i> Chỉnh sửa
            </a> -->
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
              <i class="fas fa-trash-alt me-1"></i> Xóa
            </button>
          </div>
        </div>
      </div>

      <% if (messages && messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= messages.success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <% if (messages && messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= messages.error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Thông tin phiếu nhập -->
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-file-invoice me-2"></i>
            Thông tin phiếu nhập <span class="badge bg-primary">#<%= stockImport.import_code %></span>
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th style="width: 160px;">Mã phiếu nhập:</th>
                  <td><strong><%= stockImport.import_code %></strong></td>
                </tr>
                <tr>
                  <th>Ngày nhập kho:</th>
                  <td><%= new Date(stockImport.import_date).toLocaleDateString('vi-VN') %></td>
                </tr>
                <tr>
                  <th>Nhà cung cấp:</th>
                  <td>
                    <% if (stockImport.supplier_id) { %>
                      <a href="/admin/suppliers/<%= stockImport.supplier_id %>"><%= stockImport.supplier_name %></a>
                    <% } else { %>
                      <span class="text-muted">Không có</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Người tạo:</th>
                  <td><%= stockImport.created_by_name || 'Admin' %></td>
                </tr>
              </table>
            </div>
            <div class="col-md-6">
              <table class="table table-borderless">
                <tr>
                  <th style="width: 160px;">Trạng thái thanh toán:</th>
                  <td>
                    <% if (stockImport.payment_status === 'pending' || stockImport.payment_status === 'unpaid') { %>
                      <span class="badge bg-warning">Chưa thanh toán</span>
                    <% } else if (stockImport.payment_status === 'partial') { %>
                      <span class="badge bg-info">Thanh toán một phần</span>
                    <% } else if (stockImport.payment_status === 'paid' || stockImport.payment_status === 'completed') { %>
                      <span class="badge bg-success">Đã thanh toán</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Tổng giá trị:</th>
                  <td class="text-primary fw-bold"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(stockImport.total_amount) %></td>
                </tr>
                <tr>
                  <th>Ngày tạo:</th>
                  <td>
                    <% if (stockImport.created_at) { %>
                      <%= new Date(stockImport.created_at).toLocaleString('vi-VN') %>
                    <% } else { %>
                      <span class="text-muted">Không rõ</span>
                    <% } %>
                  </td>
                </tr>
                <tr>
                  <th>Ghi chú:</th>
                  <td><%= stockImport.note || 'Không có ghi chú' %></td>
                </tr>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Danh sách sản phẩm -->
      <div class="card">
        <div class="card-header">
          <h5 class="card-title mb-0">
            <i class="fas fa-boxes me-2"></i>
            Danh sách sản phẩm 
            <% if (importItems && importItems.length > 0) { %>
              <span class="badge bg-info"><%= importItems.length %> sản phẩm</span>
            <% } %>
          </h5>
        </div>
        <div class="card-body">
          <% if (importItems && importItems.length > 0) { %>
            <div class="table-responsive">
              <table class="table table-striped table-hover">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Sản phẩm</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Giá nhập</th>
                    <th class="text-end">Thành tiền</th>
                  </tr>
                </thead>
                <tbody>
                  <% let totalAmount = 0; %>
                  <% importItems.forEach((item, index) => { %>
                    <tr>
                      <td><%= index + 1 %></td>
                      <td>
                        <a href="/admin/products/<%= item.product_id %>"><%= item.product_name %></a>
                      </td>
                      <td class="text-end"><%= item.quantity %></td>
                      <td class="text-end"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.import_price) %></td>
                      <td class="text-end">
                        <% const itemTotal = item.quantity * item.import_price; %>
                        <% totalAmount += itemTotal; %>
                        <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(itemTotal) %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
                <tfoot>
                  <tr>
                    <th colspan="4" class="text-end">Tổng cộng:</th>
                    <th class="text-end text-primary">
                      <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(totalAmount) %>
                    </th>
                  </tr>
                </tfoot>
              </table>
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <i class="fas fa-info-circle me-2"></i> Phiếu nhập kho không có sản phẩm nào.
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Modal xác nhận xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">Xác nhận xóa</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Bạn có chắc chắn muốn xóa phiếu nhập kho <strong>#<%= stockImport.import_code %></strong>?
        <div class="alert alert-warning mt-3">
          <i class="fas fa-exclamation-triangle me-2"></i> Lưu ý: Xóa phiếu nhập sẽ điều chỉnh lại số lượng tồn kho của các sản phẩm tương ứng.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <a href="/admin/stock/imports/<%= stockImport.id %>/delete" class="btn btn-danger">Xác nhận xóa</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %> 