<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar') %>
    <div class="col-md-2"> <ul class="nav flex-column">
      <li class="nav-item">
        <a class="nav-link active" href="/admin">
          <i class="fas fa-tachometer-alt me-2"></i>
          Dashboard
        </a>
      </li>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/products">
          <i class="fas fa-box me-2"></i>
          Sản phẩm
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/categories">
          <i class="fas fa-tags me-2"></i>
          Danh mục
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/orders">
          <i class="fas fa-shopping-cart me-2"></i>
          Đơn hàng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc manager-->
      <% if (user.role === 'admin' || user.role === 'manager') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/users">
          <i class="fas fa-users me-2"></i>
          Người dùng
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/suppliers">
          <i class="fas fa-truck me-2"></i>
          Nhà cung cấp
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc warehouse-->
      <% if (user.role === 'admin' || user.role === 'warehouse') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/stock/imports">
          <i class="fas fa-warehouse me-2"></i>
          Nhập kho
        </a>
      </li>
      <% } %>
      <!-- chỉ hiển thị khi là admin hoặc sale-->
      <% if (user.role === 'admin' || user.role === 'sale') { %>
      <li class="nav-item">
        <a class="nav-link" href="/admin/invoices">
          <i class="fas fa-file-invoice-dollar me-2"></i>
          Hóa đơn bán hàng
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/admin/reports/sales">
          <i class="fas fa-chart-bar me-2"></i>
          Báo cáo doanh thu
        </a>
      </li>
      <% } %>
    </ul></div>
    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Cập nhật phiếu nhập kho #<%= stockImport.import_code %></h1>
        <div class="btn-toolbar mb-2 mb-md-0">
          <a href="/admin/stock/imports/<%= stockImport.id %>" class="btn btn-sm btn-outline-secondary me-2">
            <i class="fas fa-eye me-1"></i> Xem chi tiết
          </a>
          <a href="/admin/stock/imports" class="btn btn-sm btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
          </a>
        </div>
      </div>

      <div class="row">
        <div class="col-md-12">
          <div class="card">
            <div class="card-body">
              <form action="/admin/stock/imports/<%= stockImport.id %>/edit" method="POST">
                <div class="row mb-3">
                  <div class="col-md-6">
                    <label for="import_code" class="form-label">Mã phiếu nhập</label>
                    <input type="text" class="form-control" id="import_code" value="<%= stockImport.import_code %>" readonly>
                  </div>
                  <div class="col-md-6">
                    <label for="import_date" class="form-label">Ngày nhập <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="import_date" name="import_date" value="<%= stockImport.import_date ? stockImport.import_date.toISOString().split('T')[0] : '' %>" required>
                  </div>
                </div>

                <div class="row mb-3">
                  <div class="col-md-6">
                    <label for="supplier_id" class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
                    <select class="form-select" id="supplier_id" name="supplier_id" required>
                      <option value="">-- Chọn nhà cung cấp --</option>
                      <% suppliers.forEach(function(supplier) { %>
                        <option value="<%= supplier.id %>" <%= stockImport.supplier_id == supplier.id ? 'selected' : '' %>><%= supplier.name %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label for="payment_status" class="form-label">Trạng thái thanh toán</label>
                    <select class="form-select" id="payment_status" name="payment_status">
                      <option value="pending" <%= stockImport.payment_status === 'pending' ? 'selected' : '' %>>Chưa thanh toán</option>
                      <option value="partial" <%= stockImport.payment_status === 'partial' ? 'selected' : '' %>>Thanh toán một phần</option>
                      <option value="completed" <%= stockImport.payment_status === 'completed' ? 'selected' : '' %>>Đã thanh toán</option>
                    </select>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="note" class="form-label">Ghi chú</label>
                  <textarea class="form-control" id="note" name="note" rows="3"><%= stockImport.note || '' %></textarea>
                </div>

                <div class="alert alert-info">
                  <i class="fas fa-info-circle me-2"></i> Lưu ý: Chỉ có thể cập nhật thông tin chung của phiếu nhập. Để cập nhật sản phẩm, vui lòng trở lại trang chi tiết.
                </div>

                <div class="mt-4 text-end">
                  <a href="/admin/stock/imports/<%= stockImport.id %>" class="btn btn-secondary me-2">Hủy</a>
                  <button type="submit" class="btn btn-primary">Cập nhật phiếu nhập</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
