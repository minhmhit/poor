<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link active" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/suppliers">
              <i class="fas fa-truck me-2"></i>
              Nhà cung cấp
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/stock/imports">
              <i class="fas fa-warehouse me-2"></i>
              Nhập kho
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/invoices">
              <i class="fas fa-file-invoice-dollar me-2"></i>
              Hóa đơn bán hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/reports/sales">
              <i class="fas fa-chart-bar me-2"></i>
              Báo cáo doanh thu
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Dashboard</h1>
      </div>

      <!-- Thống kê -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card text-white bg-primary mb-3">
            <div class="card-body">
              <h5 class="card-title">Sản phẩm</h5>
              <p class="card-text fs-2">5</p> <!-- Thay bằng số thực từ database -->
              <a href="/admin/products" class="text-white">Xem chi tiết <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-success mb-3">
            <div class="card-body">
              <h5 class="card-title">Đơn hàng</h5>
              <p class="card-text fs-2">1</p> <!-- Thay bằng số thực từ database -->
              <a href="/admin/orders" class="text-white">Xem chi tiết <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-info mb-3">
            <div class="card-body">
              <h5 class="card-title">Danh mục</h5>
              <p class="card-text fs-2">3</p> <!-- Thay bằng số thực từ database -->
              <a href="/admin/categories" class="text-white">Xem chi tiết <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-white bg-warning mb-3">
            <div class="card-body">
              <h5 class="card-title">Người dùng</h5>
              <p class="card-text fs-2">1</p> <!-- Thay bằng số thực từ database -->
              <a href="/admin/users" class="text-white">Xem chi tiết <i class="fas fa-arrow-right ms-1"></i></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Đơn hàng gần đây -->
      <h2 class="h4 mb-3">Đơn hàng gần đây</h2>
      <div class="table-responsive">
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th>ID</th>
              <th>Khách hàng</th>
              <th>Trạng thái</th>
              <th>Tổng tiền</th>
              <th>Ngày đặt</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1</td>
              <td>Khách hàng</td>
              <td><span class="badge bg-warning">Đang xử lý</span></td>
              <td>590,000 ₫</td>
              <td>16/04/2025</td>
              <td>
                <a href="/admin/orders/1" class="btn btn-sm btn-info">
                  <i class="fas fa-eye"></i>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Thêm phần quản lý báo cáo và hóa đơn -->
      <div class="row mt-4">
        <div class="col-12">
          <h2 class="h4 mb-3 border-bottom pb-2">Báo cáo & Hóa đơn</h2>
        </div>
      </div>
      
      <div class="row mt-3">
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><i class="fas fa-file-invoice-dollar me-2"></i>Hóa đơn bán hàng</h5>
              <p class="card-text">Xem và quản lý danh sách hóa đơn bán hàng đã phát hành.</p>
              <a href="/admin/invoices" class="btn btn-primary">Xem hóa đơn</a>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><i class="fas fa-chart-line me-2"></i>Báo cáo doanh thu</h5>
              <p class="card-text">Xem thống kê doanh thu theo ngày, tuần, tháng hoặc năm.</p>
              <div class="d-flex gap-2">
                <a href="/admin/reports/sales?period=day" class="btn btn-sm btn-outline-primary">Ngày</a>
                <a href="/admin/reports/sales?period=week" class="btn btn-sm btn-outline-primary">Tuần</a>
                <a href="/admin/reports/sales?period=month" class="btn btn-sm btn-outline-primary">Tháng</a>
                <a href="/admin/reports/sales?period=year" class="btn btn-sm btn-outline-primary">Năm</a>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 col-lg-4 mb-4">
          <div class="card h-100">
            <div class="card-body">
              <h5 class="card-title"><i class="fas fa-warehouse me-2"></i>Quản lý nhập kho</h5>
              <p class="card-text">Xem và quản lý phiếu nhập kho, lịch sử nhập xuất và thống kê kho.</p>
              <a href="/admin/stock/imports" class="btn btn-success">Xem phiếu nhập kho</a>
              <div class="mt-2">
                <a href="/admin/stock/history" class="btn btn-sm btn-outline-secondary">Lịch sử</a>
                <a href="/admin/stock/stats" class="btn btn-sm btn-outline-info">Thống kê</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
