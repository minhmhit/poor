<%- include('../partials/admin-header') %>

<div class="container-fluid">
  <div class="row">
    
    <%- include('../partials/admin-sidebar') %>
    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Tổng quan hệ thống</h1>
      </div>

      <!-- Các thống kê -->
      <div class="row mb-4 g-3">
        <% if (user.role === 'admin' || user.role === 'warehouse') { %>
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-3">
                <div class="bg-primary text-white p-3 rounded me-3">
                  <i class="fas fa-box fa-2x"></i>
                </div>
                <div>
                  <h6 class="card-subtitle text-muted mb-1">Sản phẩm</h6>
                  <!-- <h3 class="card-title m-0">5</h3> -->
                </div>
              </div>
              <a href="/admin/products" class="btn btn-sm btn-outline-primary mt-auto">Xem chi tiết</a>
            </div>
          </div>
        </div>
        <% } %>
        
        <% if (user.role === 'admin' || user.role === 'sale') { %>
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-3">
                <div class="bg-success text-white p-3 rounded me-3">
                  <i class="fas fa-shopping-cart fa-2x"></i>
                </div>
                <div>
                  <h6 class="card-subtitle text-muted mb-1">Đơn hàng</h6>
                  <!-- <h3 class="card-title m-0">1</h3> -->
                </div>
              </div>
              <a href="/admin/orders" class="btn btn-sm btn-outline-success mt-auto">Xem chi tiết</a>
            </div>
          </div>
        </div>
        <% } %>
        
        <% if (user.role === 'admin' || user.role === 'warehouse') { %>
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-3">
                <div class="bg-info text-white p-3 rounded me-3">
                  <i class="fas fa-tags fa-2x"></i>
                </div>
                <div>
                  <h6 class="card-subtitle text-muted mb-1">Danh mục</h6>
                  <!-- <h3 class="card-title m-0">3</h3> -->
                </div>
              </div>
              <a href="/admin/categories" class="btn btn-sm btn-outline-info mt-auto">Xem chi tiết</a>
            </div>
          </div>
        </div>
        <% } %>
        
        <% if (user.role === 'admin' || user.role === 'manager') { %>
        <div class="col-md-6 col-lg-3">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center mb-3">
                <div class="bg-warning text-white p-3 rounded me-3">
                  <i class="fas fa-users fa-2x"></i>
                </div>
                <div>
                  <h6 class="card-subtitle text-muted mb-1">Người dùng</h6>
                  <!-- <h3 class="card-title m-0">1</h3> -->
                </div>
              </div>
              <a href="/admin/users" class="btn btn-sm btn-outline-warning mt-auto">Xem chi tiết</a>
            </div>
          </div>
        </div>
        <% } %>
      </div>

      <div class="row g-3">
        <!-- Đơn hàng gần đây -->
        <% if (user.role === 'admin' || user.role === 'sale') { %>
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
              <h5 class="card-title m-0"><i class="fas fa-shopping-cart me-2 text-success"></i>Đơn hàng gần đây</h5>
              <a href="/admin/orders" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover align-middle">
                  <thead class="table-light">
                    <tr>
                      <th>ID</th>
                      <th>Khách hàng</th>
                      <th>Trạng thái</th>
                      <th>Tổng tiền</th>
                      <th>Thao tác</th>
                    </tr>
                  </thead>
                  <tbody>
                    <!-- lấy thông tin đơn hàng gần nhất -->
                    <tr>
                      <td>1</td>
                      <td>Minh47</td>
                      <td><span class="badge bg-warning">Đang xử lý</span></td>
                      <td>3.120.000 ₫</td>
                      <td>
                        <a href="/admin/orders/5" class="btn btn-sm btn-outline-info">
                          <i class="fas fa-eye"></i>
                        </a>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Truy cập nhanh -->
        <div class="col-lg-5">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
              <h5 class="card-title m-0"><i class="fas fa-bolt me-2 text-warning"></i>Truy cập nhanh</h5>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <% if (user.role === 'admin' || user.role === 'sale') { %>
                <div class="col-12">
                  <div class="d-grid">
                    <a href="/admin/invoices" class="btn btn-outline-primary">
                      <i class="fas fa-file-invoice-dollar me-2"></i>Quản lý hóa đơn bán hàng
                    </a>
                  </div>
                </div>
                
                <div class="col-12">
                  <div class="btn-group w-100">
                    <a href="/admin/reports/sales?period=day" class="btn btn-outline-success">Ngày</a>
                    <a href="/admin/reports/sales?period=week" class="btn btn-outline-success">Tuần</a>
                    <a href="/admin/reports/sales?period=month" class="btn btn-outline-success">Tháng</a>
                    <a href="/admin/reports/sales?period=year" class="btn btn-outline-success">Năm</a>
                  </div>
                </div>
                <% } %>
                
                <% if (user.role === 'admin' || user.role === 'warehouse') { %>
                <div class="col-12">
                  <div class="d-grid">
                    <a href="/admin/stock/imports" class="btn btn-outline-info">
                      <i class="fas fa-warehouse me-2"></i>Quản lý nhập kho
                    </a>
                  </div>
                </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/admin-footer') %>