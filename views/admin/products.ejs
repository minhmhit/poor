<%- include('../partials/admin-header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Quản lý sản phẩm</h1>
        <a href="/admin/products/add" class="btn btn-primary">
          <i class="fas fa-plus me-1"></i> Thêm sản phẩm mới
        </a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Hình ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Danh mục</th>
              <th>Giá</th>
              <th>Số lượng</th>
              <th>Ngày tạo</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(product => { %>
                <tr>
                  <td><%= product.id %></td>
                  <td>
                    <img src="<%= product.image_url %>" alt="<%= product.name %>" width="50" height="50" class="img-thumbnail">
                  </td>
                  <td><%= product.name %></td>
                  <td><%= product.category_id %></td>
                  <td><%= parseInt(product.price).toLocaleString('vi-VN') %> ₫</td>
                  <td><%= product.stock %></td>
                  <td><%= new Date(product.created_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <div class="btn-group" role="group">
                      <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-warning me-1">
                        <i class="fas fa-edit"></i>
                      </a>
                      <a href="/admin/products/delete/<%= product.id %>" class="btn btn-sm btn-danger" 
                         onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center">Không có sản phẩm nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/admin-footer') %>