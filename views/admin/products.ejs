<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link active" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <!-- chỉ hiển thị khi là admin hoặc warehouse-->
          <% if (user.role === 'admin' || user.role === 'warehouse') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc sale-->
          <% if (user.role === 'admin' || user.role === 'sale') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc sale-->
          <% if (user.role === 'admin' || user.role === 'sale') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc manager-->
          <% if (user.role === 'admin' || user.role === 'manager') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc warehouse-->
          <% if (user.role === 'admin' || user.role === 'warehouse') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/suppliers">
              <i class="fas fa-truck me-2"></i>
              Nhà cung cấp
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc warehouse-->
          <% if (user.role === 'admin' || user.role === 'warehouse') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/stock/imports">
              <i class="fas fa-warehouse me-2"></i>
              Nhập kho
            </a>
          </li>
          <% } %>
          <!-- chỉ hiển thị khi là admin hoặc sale-->
          <% if (user.role === 'admin' || user.role === 'sale') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/invoices">
              <i class="fas fa-file-invoice-dollar me-2"></i>
              Hóa đơn bán hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/reports/sales">
              <i class="fas fa-chart-bar me-2"></i>
              Báo cáo doanh thu
            </a>
          </li>
          <% } %>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Quản lý sản phẩm</h1>
        <a href="/admin/products/add" class="btn btn-primary">
          <i class="fas fa-plus me-1"></i> Thêm sản phẩm mới
        </a>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Hình ảnh</th>
              <th>Tên sản phẩm</th>
              <th>Danh mục</th>
              <th>Giá</th>
              <th>Số lượng</th>
              <th>Ngày tạo</th>
              <th>Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% if (products && products.length > 0) { %>
              <% products.forEach(product => { %>
                <tr>
                  <td><%= product.id %></td>
                  <td>
                    <img src="<%= product.image_url %>" alt="<%= product.name %>" width="50" height="50" class="img-thumbnail">
                  </td>
                  <td><%= product.name %></td>
                  <td><%= product.category_id %></td>
                  <td><%= parseInt(product.price).toLocaleString('vi-VN') %> ₫</td>
                  <td><%= product.stock %></td>
                  <td><%= new Date(product.created_at).toLocaleDateString('vi-VN') %></td>
                  <td>
                    <div class="btn-group" role="group">
                      <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-warning me-1">
                        <i class="fas fa-edit"></i>
                      </a>
                      <a href="/admin/products/delete/<%= product.id %>" class="btn btn-sm btn-danger" 
                         onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')">
                        <i class="fas fa-trash"></i>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center">Không có sản phẩm nào</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>
