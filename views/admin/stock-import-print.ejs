<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/all.min.css">
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }
    .invoice-box {
      max-width: 800px;
      margin: auto;
      padding: 30px;
      border: 1px solid #eee;
      box-shadow: 0 0 10px rgba(0, 0, 0, .15);
      font-size: 14px;
      line-height: 24px;
    }
    .invoice-box table {
      width: 100%;
      line-height: inherit;
      text-align: left;
    }
    .invoice-box table td {
      padding: 5px;
      vertical-align: top;
    }
    .invoice-box table tr.top table td {
      padding-bottom: 20px;
    }
    .invoice-box table tr.top table td.title {
      font-size: 40px;
      color: #333;
    }
    .invoice-box table tr.heading td {
      background: #eee;
      border-bottom: 1px solid #ddd;
      font-weight: bold;
    }
    .invoice-box table tr.details td {
      padding-bottom: 20px;
    }
    .invoice-box table tr.item td {
      border-bottom: 1px solid #eee;
    }
    .invoice-box table tr.item.last td {
      border-bottom: none;
    }
    .invoice-box table tr.total td {
      border-top: 2px solid #eee;
      font-weight: bold;
    }
    .text-right {
      text-align: right;
    }
    .print-button {
      max-width: 800px;
      margin: 20px auto;
      text-align: right;
    }
    @media print {
      .print-button, .no-print {
        display: none;
      }
      body {
        padding: 0;
      }
      .invoice-box {
        border: none;
        box-shadow: none;
      }
    }
  </style>
</head>
<body>
  <div class="print-button">
    <button type="button" class="btn btn-primary" onclick="window.print()">
      <i class="fas fa-print"></i> In phiếu nhập kho
    </button>
    <a href="/admin/stock/imports/<%= stockImport.id %>" class="btn btn-secondary ms-2">
      <i class="fas fa-arrow-left"></i> Quay lại
    </a>
  </div>
  
  <div class="invoice-box">
    <table cellpadding="0" cellspacing="0">
      <tr class="top">
        <td colspan="4">
          <table>
            <tr>
              <td class="title">
                <h4>MY SHOP</h4>
              </td>
              <td class="text-right">
                <h4>PHIẾU NHẬP KHO</h4>
                Mã phiếu: <strong>#<%= stockImport.import_code %></strong><br>
                Ngày nhập: <%= new Date(stockImport.import_date).toLocaleDateString('vi-VN') %><br>
                Trạng thái thanh toán: <span class="badge bg-<%= stockImport.payment_status === 'completed' ? 'success' : (stockImport.payment_status === 'partial' ? 'warning' : 'danger') %>">
                  <%= stockImport.payment_status === 'completed' ? 'Đã thanh toán' : (stockImport.payment_status === 'partial' ? 'Thanh toán một phần' : 'Chưa thanh toán') %>
                </span>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <tr class="information">
        <td colspan="4">
          <table>
            <tr>
              <td>
                <strong>Thông tin cửa hàng:</strong><br>
                MY SHOP<br>
                123 Đường ABC, Quận XYZ<br>
                TP.HCM, Việt Nam<br>
                Email: info@myshop.com<br>
                SĐT: 0123456789
              </td>
              <td class="text-right">
                <strong>Thông tin nhà cung cấp:</strong><br>
                <%= stockImport.supplier_name || 'Không có' %><br>
                Địa chỉ: <%= stockImport.supplier_address || 'Không có' %><br>
                SĐT: <%= stockImport.supplier_phone || 'Không có' %><br>
                Email: <%= stockImport.supplier_email || 'Không có' %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <tr class="heading">
        <td style="width: 40%;">Sản phẩm</td>
        <td style="width: 20%;" class="text-right">Đơn giá</td>
        <td style="width: 15%;" class="text-right">Số lượng</td>
        <td style="width: 25%;" class="text-right">Thành tiền</td>
      </tr>
      
      <% 
      let subtotal = 0;
      if (stockImport.items && stockImport.items.length > 0) {
        stockImport.items.forEach((item, index) => {
          subtotal += item.import_price * item.quantity;
      %>
        <tr class="item <%= index === stockImport.items.length - 1 ? 'last' : '' %>">
          <td><%= item.product_name %> <small class="text-muted">(<%= item.sku || 'Không có SKU' %>)</small></td>
          <td class="text-right"><%= item.import_price.toLocaleString('vi-VN') %> đ</td>
          <td class="text-right"><%= item.quantity %></td>
          <td class="text-right"><%= (item.import_price * item.quantity).toLocaleString('vi-VN') %> đ</td>
        </tr>
      <% }); } %>
      
      <tr class="total">
        <td colspan="3" class="text-right"><strong>Tổng giá trị:</strong></td>
        <td class="text-right"><strong><%= subtotal.toLocaleString('vi-VN') %> đ</strong></td>
      </tr>
      
      <tr>
        <td colspan="4" style="padding-top: 30px;">
          <% if (stockImport.note) { %>
          <p><strong>Ghi chú:</strong> <%= stockImport.note %></p>
          <% } %>
        </td>
      </tr>
      
      <tr>
        <td colspan="4" style="padding-top: 20px;">
          <table style="width: 100%;">
            <tr>
              <td style="width: 33%;" class="text-center">
                <p style="margin-bottom: 80px;">Người giao hàng</p>
                <p><em>(Ký, ghi rõ họ tên)</em></p>
              </td>
              <td style="width: 33%;" class="text-center">
                <p style="margin-bottom: 80px;">Người nhận hàng</p>
                <p><em>(Ký, ghi rõ họ tên)</em></p>
                <p><%= currentUser.name %></p>
              </td>
              <td style="width: 33%;" class="text-center">
                <p style="margin-bottom: 80px;">Quản lý kho</p>
                <p><em>(Ký, ghi rõ họ tên)</em></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
    
    <div style="text-align: center; margin-top: 30px; font-style: italic; font-size: 12px;">
      <p>Phiếu nhập kho này được in ngày: <%= new Date().toLocaleString('vi-VN') %></p>
    </div>
  </div>
</body>
</html> 