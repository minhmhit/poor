<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Sidebar -->
    <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-4">
      <div class="position-sticky pt-3">
        <h5 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mb-4 text-muted">
          <span>Quản trị viên</span>
        </h5>
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link" href="/admin">
              <i class="fas fa-tachometer-alt me-2"></i>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/products">
              <i class="fas fa-box me-2"></i>
              Sản phẩm
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/admin/categories">
              <i class="fas fa-tags me-2"></i>
              Danh mục
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/orders">
              <i class="fas fa-shopping-cart me-2"></i>
              Đơn hàng
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/users">
              <i class="fas fa-users me-2"></i>
              Người dùng
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Main content -->
    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><%= category.category_id ? 'Chỉnh sửa danh mục' : 'Thêm danh mục mới' %></h1>
        <a href="/admin/categories" class="btn btn-secondary">
          <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <form action="<%= category.category_id ? `/admin/categories/edit/${category.category_id}` : '/admin/categories/add' %>" method="POST">
            <div class="mb-3">
              <label for="category_name" class="form-label">Tên danh mục</label>
              <input type="text" class="form-control" id="category_name" name="category_name" value="<%= category.category_name || '' %>" required>
            </div>
            
            <div class="mb-3">
              <label for="description" class="form-label">Mô tả danh mục</label>
              <textarea class="form-control" id="description" name="description" rows="4"><%= category.description || '' %></textarea>
            </div>

            <div class="text-end">
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i> <%= category.category_id ? 'Cập nhật' : 'Thêm mới' %>
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %> 