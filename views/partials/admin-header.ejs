<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Hệ Thống Bán Cà Phê Bột' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Thêm CSS cho trang admin -->
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-primary bg-opacity-75 shadow">
            <div class="container">
                <a class="navbar-brand text-white" href="/admin">
                    <i class="fas fa-coffee me-2"></i>
                </a>
                <div class="mx-auto order-0">
                    <span class="navbar-brand mx-auto fw-bold text-white">Coffee House System</span>
                </div>
                <div class="order-3 ms-auto">
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle me-1"></i> <%= user.name %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <% if (user.role === 'admin') { %>
                                <li><a class="dropdown-item" href="/admin"><i class="fas fa-cog me-1"></i> Quản trị hệ thống</a></li>
                                <li><hr class="dropdown-divider"></li>
                            <% } %>
                            <li><a class="dropdown-item" href="/user/profile"><i class="fas fa-user me-1"></i> Tài khoản của tôi</a></li>
                            <li><a class="dropdown-item" href="/user/orders"><i class="fas fa-shopping-bag me-1"></i> Đơn hàng của tôi</a></li>
                            <li><a class="dropdown-item" href="/"><i class="fas fa-store me-1"></i> Xem cửa hàng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/auth/logout"><i class="fas fa-sign-out-alt me-1"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4">
</main> 