<%- include('partials/header') %>

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/products">Sản phẩm</a></li>
            <li class="breadcrumb-item"><a href="/products/category/<%= product.category_id %>"><%= product.category_name %></a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
        </ol>
    </nav>

    <div class="row mb-5">
        <div class="col-md-5">
            <% if (product.image_url) { %>
                <img src="<%= product.image_url %>" class="img-fluid rounded" alt="<%= product.name %>">
            <% } else { %>
                <div class="d-flex align-items-center justify-content-center bg-secondary text-white rounded" style="height: 400px;">
                    <i class="fas fa-coffee fa-5x"></i>
                </div>
            <% } %>
        </div>
        <div class="col-md-7">
            <h1 class="mb-3"><%= product.name %></h1>
            <p class="badge bg-secondary mb-3"><%= product.category_name %></p>
            
            <h4 class="text-danger mb-4"><%= parseInt(product.price).toLocaleString('vi-VN') %> ₫</h4>
            
            <div class="mb-4">
                <p><%= product.description %></p>
            </div>
            
            <div class="mb-4">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <p class="mb-0">Số lượng:</p>
                    </div>
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary" type="button" id="decrease-qty">-</button>
                        <input type="number" class="form-control text-center" id="product-quantity" value="1" min="1" max="<%= product.stock %>">
                        <button class="btn btn-outline-secondary" type="button" id="increase-qty">+</button>
                    </div>
                    <div class="ms-3">
                        <p class="mb-0">Còn <span class="fw-bold"><%= product.stock %></span> sản phẩm</p>
                    </div>
                </div>
            </div>
            
            <div class="d-grid gap-2">
                <button class="btn btn-primary add-to-cart-detail" data-id="<%= product.id %>" type="button">
                    <i class="fas fa-cart-plus me-2"></i>Thêm vào giỏ hàng
                </button>
                <button class="btn btn-outline-primary buy-now" data-id="<%= product.id %>" type="button">
                    <i class="fas fa-bolt me-2"></i>Mua ngay
                </button>
            </div>
            
            <div class="mt-4 p-3 border rounded">
                <h5><i class="fas fa-truck me-2"></i>Thông tin vận chuyển</h5>
                <ul class="list-unstyled mb-0">
                    <li><i class="fas fa-check-circle text-success me-2"></i>Miễn phí giao hàng cho đơn từ 500.000đ</li>
                    <li><i class="fas fa-check-circle text-success me-2"></i>Giao hàng toàn quốc (2-5 ngày)</li>
                </ul>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-12">
            <h3 class="mb-4">Thông tin chi tiết</h3>
            <table class="table table-striped">
                <tbody>
                    <tr>
                        <th style="width: 30%">Loại cà phê</th>
                        <td><%= product.category_name %></td>
                    </tr>
                    <tr>
                        <th>Khối lượng</th>
                        <td>250g</td>
                    </tr>
                    <tr>
                        <th>Độ rang</th>
                        <td>Medium Roast</td>
                    </tr>
                    <tr>
                        <th>Hướng dẫn bảo quản</th>
                        <td>Bảo quản nơi khô ráo, thoáng mát, tránh ánh nắng trực tiếp.</td>
                    </tr>
                    <tr>
                        <th>Hạn sử dụng</th>
                        <td>12 tháng kể từ ngày sản xuất</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4">Sản phẩm tương tự</h3>
            <div class="row">
                <!-- Phần này sẽ được thay thế bằng dữ liệu thực tế -->
                <div class="col-md-3 mb-4">
                    <div class="card h-100">
                        <div class="bg-light" style="height: 200px;">
                            <div class="d-flex align-items-center justify-content-center h-100 bg-secondary text-white">
                                <i class="fas fa-coffee fa-3x"></i>
                            </div>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">Sản phẩm tương tự</h5>
                            <p class="card-text text-muted">Cà phê Arabica</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-danger">150.000 ₫</span>
                                <button class="btn btn-sm btn-outline-primary add-to-cart">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Lặp lại 3 lần nữa tương tự -->
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
            const decreaseBtn = document.getElementById('decrease-qty');
            const increaseBtn = document.getElementById('increase-qty');
            const quantityInput = document.getElementById('product-quantity');
            const stock = parseInt('<%= product.stock %>', 10);

            // Hàm cập nhật số lượng
            function updateQuantity(change) {
                let currentQuantity = parseInt(quantityInput.value, 10);
                let newQuantity = currentQuantity + change;

                // Đảm bảo số lượng không nhỏ hơn 1 và không lớn hơn stock
                if (newQuantity < 1) {
                    newQuantity = 1;
                } else if (newQuantity > stock) {
                    newQuantity = stock;
                }

                quantityInput.value = newQuantity;
            }

            // Xử lý nút giảm
            decreaseBtn.addEventListener('click', function () {
                updateQuantity(-1);
            });

            // Xử lý nút tăng
            increaseBtn.addEventListener('click', function () {
                updateQuantity(1);
            });

            // Xử lý khi người dùng nhập thủ công
            quantityInput.addEventListener('input', function () {
                let currentQuantity = parseInt(quantityInput.value, 10);
                if (isNaN(currentQuantity) || currentQuantity < 1) {
                    quantityInput.value = 1;
                } else if (currentQuantity > stock) {
                    quantityInput.value = stock;
                }
            });
    });

    document.addEventListener('DOMContentLoaded', function() {
        const quantityInput = document.getElementById('product-quantity');
        const decreaseBtn = document.getElementById('decrease-qty');
        const increaseBtn = document.getElementById('increase-qty');
        const maxStock = <%= product.stock %>;
        
        // Xử lý nút tăng giảm số lượng
        decreaseBtn.addEventListener('click', function() {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue > 1) {
                quantityInput.value = currentValue - 1;
            }
        });
        
        increaseBtn.addEventListener('click', function() {
            let currentValue = parseInt(quantityInput.value);
            if (currentValue < maxStock) {
                quantityInput.value = currentValue + 1;
            }
        });
        
        // Xử lý thêm vào giỏ hàng
        const addToCartBtn = document.querySelector('.add-to-cart-detail');
        addToCartBtn.addEventListener('click', function() {
            const productId = this.getAttribute('data-id');
            const quantity = parseInt(quantityInput.value);
            
            // Gọi API thêm vào giỏ hàng
            fetch('/api/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productId,
                    quantity
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Đã thêm sản phẩm vào giỏ hàng!');
                    // Cập nhật số lượng hiển thị trên icon giỏ hàng
                }
            })
            .catch(error => {
                console.error('Lỗi khi thêm vào giỏ hàng:', error);
            });
        });
        
        // Xử lý mua ngay
        const buyNowBtn = document.querySelector('.buy-now');
        buyNowBtn.addEventListener('click', function() {
            const productId = this.getAttribute('data-id');
            const quantity = parseInt(quantityInput.value);
            
            // Lưu thông tin sản phẩm vào localStorage
            localStorage.setItem('buyNow', JSON.stringify({
                productId,
                quantity
            }));
            
            // Chuyển hướng đến trang thanh toán
            window.location.href = '/checkout';
        });
    });
</script>

<%- include('partials/footer') %> 