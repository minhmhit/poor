<%- include('partials/header') %>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="display-1 text-success">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                    <h1 class="mb-3">Đặt hàng thành công!</h1>
                    <p class="lead mb-4">Cảm ơn bạn đã đặt hàng tại Coffee House. Chúng tôi đã nhận được đơn đặt hàng của bạn.</p>
                    
                    <div class="alert alert-success mb-4">
                        <strong>Mã đơn hàng của bạn:</strong> #<%= orderId %>
                    </div>
                    
                    <p class="mb-4">Chúng tôi sẽ liên hệ với bạn trong thời gian sớm nhất để xác nhận đơn hàng. Bạn có thể theo dõi trạng thái đơn hàng trong mục "Đơn hàng của tôi" trong tài khoản của bạn.</p>
                    
                    <div class="d-grid gap-3 col-md-6 mx-auto">
                        <a href="/" class="btn btn-primary">Quay về trang chủ</a>
                        <a href="/products" class="btn btn-outline-dark">Tiếp tục mua sắm</a>
                    </div>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">Bạn có thắc mắc?</h5>
                    <p class="card-text">Nếu bạn có bất kỳ câu hỏi nào về đơn hàng của mình, vui lòng liên hệ với chúng tôi:</p>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-phone me-2 text-primary"></i> (028) 1234 5678</li>
                        <li><i class="fas fa-envelope me-2 text-primary"></i> support@coffeehouse.com</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>